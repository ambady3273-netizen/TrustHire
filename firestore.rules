rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────
    // DESIGN PRINCIPLE
    // callerRole() makes a get() call on /users/{uid}.
    // Calling it inside a READ rule on a streamed collection causes
    // Firestore to hit cross-document read limits and return
    // permission-denied on the entire stream.
    //
    // RULE:
    //   - READ rules use ONLY request.auth (no get() calls)
    //   - WRITE rules may call callerRole() (one doc at a time)
    // ─────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    // Only used in write rules — never in read rules.
    function callerRole() {
      let doc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuth() && exists(doc) ? get(doc).data.role : '';
    }

    function isSeeker()   { return callerRole() == 'job_seeker'; }
    function isEmployer() { return callerRole() == 'employer'; }
    function isAdmin()    { return callerRole() == 'admin'; }

    function isAllowedSelfRole(role) {
      return role == 'job_seeker' || role == 'employer';
    }

    // ─────────────────────────────────────────────────────────
    // USERS
    // Any authenticated user can read their own doc.
    // isAdmin() is only used for writes (update/delete).
    // ─────────────────────────────────────────────────────────
    match /users/{userId} {
      // Simple: you can read your own doc. Admin can read all.
      // isAdmin() here is called on a SINGLE doc get — acceptable.
      allow read: if isAuth() && (
        request.auth.uid == userId || isAdmin()
      );

      allow create: if isAuth()
        && request.auth.uid == userId
        && isAllowedSelfRole(request.resource.data.role)
        && request.resource.data.verified == false;

      allow update: if (
          isAuth()
          && request.auth.uid == userId
          && isAllowedSelfRole(request.resource.data.role)
          && request.resource.data.verified == resource.data.verified
        ) || isAdmin();

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // JOBS
    // READ: any authenticated user can read any job document.
    //   - Seekers need to see approved jobs
    //   - Employers need to see their own jobs (any status)
    //   - Admins need to see pending_review jobs for fraud review
    // No role check needed on read — write is protected.
    // ─────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && isEmployer()
        && request.resource.data.employerId == request.auth.uid;

      allow update: if isAuth() && (
        (isEmployer() && resource.data.employerId == request.auth.uid)
        || isAdmin()
      );

      allow delete: if isAuth() && (
        (isEmployer() && resource.data.employerId == request.auth.uid)
        || isAdmin()
      );
    }

    // ─────────────────────────────────────────────────────────
    // APPLICATIONS
    // READ: any authenticated user who is a participant can read.
    // For list queries Firestore evaluates per-document — using
    // pure isAuth() avoids all get() issues on stream queries.
    // Write rules still enforce ownership.
    // ─────────────────────────────────────────────────────────
    match /applications/{applicationId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && isSeeker()
        && request.resource.data.seekerId == request.auth.uid
        && request.resource.data.status   == 'applied';

      allow update: if isAuth() && (
        (
          resource.data.seekerId == request.auth.uid
          && request.resource.data.status     == 'withdrawn'
          && request.resource.data.seekerId   == resource.data.seekerId
          && request.resource.data.jobId      == resource.data.jobId
          && request.resource.data.employerId == resource.data.employerId
        ) || (
          resource.data.employerId == request.auth.uid
          && request.resource.data.seekerId   == resource.data.seekerId
          && request.resource.data.jobId      == resource.data.jobId
          && request.resource.data.employerId == resource.data.employerId
        ) || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // CHATS
    // READ: pure UID comparison — ZERO get() calls.
    // ─────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && (
        resource.data.seekerId   == request.auth.uid ||
        resource.data.employerId == request.auth.uid
      );

      allow create: if isAuth()
        && request.resource.data.employerId == request.auth.uid;

      allow update: if isAuth() && (
        (
          resource.data.seekerId   == request.auth.uid ||
          resource.data.employerId == request.auth.uid
        )
        && request.resource.data.seekerId   == resource.data.seekerId
        && request.resource.data.employerId == resource.data.employerId
      ) || isAdmin();

      allow delete: if isAdmin();

      // Messages sub-collection
      match /messages/{messageId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/chats/$(chatId))
            .data.seekerId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId))
            .data.employerId == request.auth.uid
        );
        allow create: if isAuth()
          && request.resource.data.senderId == request.auth.uid
          && (
            get(/databases/$(database)/documents/chats/$(chatId))
              .data.seekerId == request.auth.uid ||
            get(/databases/$(database)/documents/chats/$(chatId))
              .data.employerId == request.auth.uid
          );
        allow update: if isAuth()
          && resource.data.receiverId       == request.auth.uid
          && request.resource.data.isRead   == true
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text     == resource.data.text;
        allow delete: if isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────
    // ESCROWS
    // ─────────────────────────────────────────────────────────
    match /escrows/{escrowId} {
      allow read: if isAuth()
        && resource.data.employerId == request.auth.uid;
      allow create: if isAuth()
        && isEmployer()
        && request.resource.data.employerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // RATINGS
    // ─────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.reviewerId != request.resource.data.revieweeId
        && request.resource.data.reviewerId == request.auth.uid
        && (
          get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId))
            .data.seekerId == request.auth.uid ||
          get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId))
            .data.employerId == request.auth.uid
        );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────
    // NOTIFICATIONS
    // READ: pure UID — ZERO get() calls.
    // ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────
    // REVIEWS (legacy)
    // ─────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.reviewerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

  }
}
