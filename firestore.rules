rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ──────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Safe role lookup — only called for operations that truly need
    // role verification (create/update). Never called inside READ
    // rules on collections to avoid cross-document read limits on
    // streaming queries.
    function callerRole() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuth() && exists(userDoc) ? get(userDoc).data.role : '';
    }

    function isSeeker()   { return isAuth() && callerRole() == 'job_seeker'; }
    function isEmployer() { return isAuth() && callerRole() == 'employer'; }
    function isAdmin()    { return isAuth() && callerRole() == 'admin'; }

    function isAllowedSelfRole(role) {
      return role == 'job_seeker' || role == 'employer';
    }

    // ──────────────────────────────────────────────────────────
    // USERS
    // ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isAuth()
        && request.auth.uid == userId
        && isAllowedSelfRole(request.resource.data.role)
        && request.resource.data.verified == false;
      allow update: if (
          isOwner(userId)
          && isAllowedSelfRole(request.resource.data.role)
          && request.resource.data.verified == resource.data.verified
        ) || isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // JOBS
    // ──────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      // READ: no callerRole() — pure UID comparison avoids get() on
      // streaming queries.
      allow read: if isAuth() && (
        resource.data.status == 'approved' ||
        resource.data.employerId == request.auth.uid
      );
      allow create: if isEmployer()
        && request.resource.data.employerId == request.auth.uid;
      allow update: if (
          isEmployer() && resource.data.employerId == request.auth.uid
        ) || isAdmin();
      allow delete: if (
          isEmployer() && resource.data.employerId == request.auth.uid
        ) || isAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // APPLICATIONS
    // ──────────────────────────────────────────────────────────
    match /applications/{applicationId} {
      // ── READ ─────────────────────────────────────────────────
      // IMPORTANT: No callerRole() / isAdmin() here — those trigger
      // a get() call which breaks streaming queries (permission-denied).
      // Pure UID comparisons only.
      allow read: if isAuth() && (
        resource.data.seekerId   == request.auth.uid ||
        resource.data.employerId == request.auth.uid
      );

      // ── CREATE ───────────────────────────────────────────────
      allow create: if isSeeker()
        && request.resource.data.seekerId == request.auth.uid
        && request.resource.data.status   == 'applied';

      // ── UPDATE ───────────────────────────────────────────────
      allow update: if isAuth() && (
        (
          // Seeker withdraws
          resource.data.seekerId == request.auth.uid
          && request.resource.data.status     == 'withdrawn'
          && request.resource.data.seekerId   == resource.data.seekerId
          && request.resource.data.jobId      == resource.data.jobId
          && request.resource.data.employerId == resource.data.employerId
        ) || (
          // Employer updates status
          resource.data.employerId == request.auth.uid
          && request.resource.data.seekerId   == resource.data.seekerId
          && request.resource.data.jobId      == resource.data.jobId
          && request.resource.data.employerId == resource.data.employerId
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // CHATS
    // ──────────────────────────────────────────────────────────
    match /chats/{chatId} {
      // READ: pure UID comparison — no callerRole().
      allow read: if isAuth() && (
        resource.data.seekerId   == request.auth.uid ||
        resource.data.employerId == request.auth.uid
      );
      allow create: if isAuth()
        && request.resource.data.employerId == request.auth.uid;
      allow update: if isAuth() && (
        (
          resource.data.seekerId   == request.auth.uid ||
          resource.data.employerId == request.auth.uid
        )
        && request.resource.data.seekerId   == resource.data.seekerId
        && request.resource.data.employerId == resource.data.employerId
      ) || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        // READ: look up parent chat — only 1 get() per message read.
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.seekerId
            == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.employerId
            == request.auth.uid
        );
        allow create: if isAuth()
          && request.resource.data.senderId == request.auth.uid
          && (
            get(/databases/$(database)/documents/chats/$(chatId)).data.seekerId
              == request.auth.uid ||
            get(/databases/$(database)/documents/chats/$(chatId)).data.employerId
              == request.auth.uid
          );
        allow update: if isAuth()
          && resource.data.receiverId       == request.auth.uid
          && request.resource.data.isRead   == true
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text     == resource.data.text;
        allow delete: if isAdmin();
      }
    }

    // ──────────────────────────────────────────────────────────
    // ESCROWS
    // ──────────────────────────────────────────────────────────
    match /escrows/{escrowId} {
      allow read: if isAuth()
        && resource.data.employerId == request.auth.uid;
      allow create: if isEmployer()
        && request.resource.data.employerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // RATINGS
    // ──────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.reviewerId != request.resource.data.revieweeId
        && request.resource.data.reviewerId == request.auth.uid
        && (
          get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.seekerId
            == request.auth.uid ||
          get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.employerId
            == request.auth.uid
        );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // NOTIFICATIONS
    // ──────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // READ: pure UID — no callerRole().
      allow read:   if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ──────────────────────────────────────────────────────────
    // REVIEWS (legacy)
    // ──────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read:   if isAuth();
      allow create: if isAuth()
        && request.resource.data.reviewerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

  }
}
