rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ──────────────────────────────────────────────────────────

    /// Is the request made by a signed-in user?
    function isAuth() {
      return request.auth != null;
    }

    /// Is the requesting user the document owner (by uid field)?
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    /// Read the caller's role from their Firestore user document.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSeeker() {
      return isAuth() && callerRole() == 'job_seeker';
    }

    function isEmployer() {
      return isAuth() && callerRole() == 'employer';
    }

    function isAdmin() {
      return isAuth() && callerRole() == 'admin';
    }

    // ──────────────────────────────────────────────────────────
    // USERS COLLECTION
    // ──────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read their own profile.
      allow read: if isOwner(userId) || isAdmin();

      // Only the user themselves can create/update their own doc.
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();

      // Deletion only by admin.
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // JOBS COLLECTION
    // ──────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      // Any authenticated user can read approved jobs.
      // Employers can also read their own jobs regardless of status.
      allow read: if isAuth() && (
        resource.data.status == 'approved' ||
        resource.data.employerId == request.auth.uid ||
        isAdmin()
      );

      // Only employers can create jobs.
      allow create: if isEmployer() &&
        request.resource.data.employerId == request.auth.uid;

      // Only the owning employer or admin can update/delete.
      allow update: if (isEmployer() &&
        resource.data.employerId == request.auth.uid) || isAdmin();
      allow delete: if (isEmployer() &&
        resource.data.employerId == request.auth.uid) || isAdmin();
    }

    // ──────────────────────────────────────────────────────────
    // APPLICATIONS COLLECTION
    // ──────────────────────────────────────────────────────────
    match /applications/{applicationId} {

      // ── Read access ──────────────────────────────────────────
      // Seekers can read only their own applications.
      // Employers can read applications where they are the employer.
      // Admins can read all.
      allow read: if isAuth() && (
        resource.data.seekerId == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        isAdmin()
      );

      // ── Create ───────────────────────────────────────────────
      // Only job seekers can create; they must set themselves as seekerId.
      // Prevents employers/admins from submitting applications.
      allow create: if isSeeker() &&
        request.resource.data.seekerId == request.auth.uid &&
        request.resource.data.status == 'applied';

      // ── Update ───────────────────────────────────────────────
      // Seeker can only change status to 'withdrawn' on their own application.
      // Employer can change status to accepted/rejected/under_review/shortlisted
      //   only on applications where they are the employer.
      // Admin can update any field.
      allow update: if isAuth() && (
        // Seeker withdraws their own application
        (resource.data.seekerId == request.auth.uid &&
         request.resource.data.status == 'withdrawn' &&
         request.resource.data.seekerId == resource.data.seekerId &&
         request.resource.data.jobId == resource.data.jobId &&
         request.resource.data.employerId == resource.data.employerId
        ) ||
        // Employer changes status on their own job's applications
        (resource.data.employerId == request.auth.uid &&
         request.resource.data.seekerId == resource.data.seekerId &&
         request.resource.data.jobId == resource.data.jobId &&
         request.resource.data.employerId == resource.data.employerId
        ) ||
        // Admin can update anything
        isAdmin()
      );

      // ── Delete ───────────────────────────────────────────────
      // Only admin can hard-delete applications.
      allow delete: if isAdmin();
    }

  }
}
